PORT=4000
FIREBASE_PROJECT_ID=dear-you-invites
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_SECRET=change-this-to-a-random-secret
JWT_REFRESH_SECRET=change-this-to-another-random-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ─── Client-side Firebase config (for the web app) ───
# These values are needed in client/.env for the Firebase Auth SDK:
# VITE_FIREBASE_API_KEY=...
# VITE_FIREBASE_AUTH_DOMAIN=themaking-d6293.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=themaking-d6293
# VITE_FIREBASE_APP_ID=...
